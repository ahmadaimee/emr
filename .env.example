# ---------------------------------------------------------------------------
# Grove — local development environment.
# Copy to .env and fill in. NEVER commit .env, and never put real PHI in seeds.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database -------------------------------------------------------------
# The app connects as grove_app — a non-owner, non-superuser, NOBYPASSRLS role —
# so row-level security is actually enforced. Migrations run as the owner.
DATABASE_URL=postgres://grove_app:grove_local_dev@localhost:5432/grove
DATABASE_MIGRATION_URL=postgres://grove:grove_local_dev@localhost:5432/grove

# --- Object storage (documents, ERA files, statement PDFs) ----------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=grove-documents
S3_ACCESS_KEY_ID=grove
S3_SECRET_ACCESS_KEY=grove_local_dev
S3_FORCE_PATH_STYLE=true

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000
SESSION_IDLE_TIMEOUT_MINUTES=15      # HIPAA 164.312(a)(2)(iii) automatic logoff
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_FRESH_MINUTES=5              # step-up re-auth window for sensitive actions
MFA_REQUIRED=true

# --- Encryption -----------------------------------------------------------
# Application-level envelope encryption for the most sensitive columns (SSN,
# MFA secrets). Rotate via the key-version mechanism, never by overwriting.
PHI_ENCRYPTION_KEY=replace-me
PHI_ENCRYPTION_KEY_VERSION=1

# Secret keying the audit hash chain. If this leaks, chain forgery is possible.
AUDIT_CHAIN_SECRET=replace-me

# --- Clearinghouse --------------------------------------------------------
# CLEARINGHOUSE_PROVIDER: stedi | claimmd | mock
# 'mock' replays canned X12 fixtures so the whole lifecycle is testable offline.
CLEARINGHOUSE_PROVIDER=mock
STEDI_API_KEY=
STEDI_BASE_URL=https://healthcare.us.stedi.com/2024-04-01
CLAIMMD_ACCOUNT_KEY=
CLAIMMD_BASE_URL=https://svc.claim.md/services

# --- Trading partner identifiers (your submitter identity in the ISA/GS) ---
EDI_SUBMITTER_ID=
EDI_SUBMITTER_NAME=ORCHARD MEDICAL MGMT
EDI_ISA_SENDER_ID=
EDI_ISA_QUALIFIER=ZZ
EDI_USAGE_INDICATOR=T                # T until production approval, then P

# --- Automation cost controls ---------------------------------------------
# Every external call is metered. Hard daily caps prevent a scheduler bug from
# generating a five-figure clearinghouse bill over a weekend.
AUTOMATION_DAILY_BUDGET_CENTS=50000
AUTOMATION_ELIGIBILITY_MAX_PER_MINUTE=120
AUTOMATION_STATUS_MAX_PER_MINUTE=60

# --- Payments -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Mail -----------------------------------------------------------------
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@grove.local

# --- Observability --------------------------------------------------------
LOG_LEVEL=debug
LOG_REDACT_PHI=true                  # keep true outside of local debugging
