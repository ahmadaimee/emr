{
  "name": "@grove/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "reset": "tsx src/migrate.ts --reset",
    "seed": "tsx src/seed/index.ts",
    "check-rls": "tsx src/tools/check-rls-coverage.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.0"
  }
}
